# URL du serveur Firebase Realtime Database (sans slash final)
FIREBASE_URL=https://chaine-du-froid-default-rtdb.europe-west1.firebasedatabase.app

# URL de connexion MongoDB (ex: mongodb://localhost:27017 ou chaîne MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017

# Nom de la base de données MongoDB
MONGO_DB=chaine_froid

# Seuils de température conforme en °C
TEMP_MIN=2.0
TEMP_MAX=8.0

# Nombre de mesures consécutives hors plage déclenchant une alerte
ALERT_MIN_READINGS=3

# Intervalle d'interrogation Firebase en secondes
POLL_SECONDS=2.0

# Seuil en secondes à partir duquel le capteur est considéré hors ligne
STALE_SECONDS=30.0
